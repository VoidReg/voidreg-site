{
  "name": "voidreg-publishing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --alias:@voidreg/authoring=../../packages/authoring/src --alias:@voidreg/publishing-ui=../../packages/publishing-ui/src --external:*.svelte --outfile=dist/server.mjs",
    "check": "tsc -p tsconfig.json",
    "smoke": "node smoke.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@publisle/adapter-core": "catalog:",
    "@publisle/block-sdk": "catalog:",
    "@publisle/blocks-core": "catalog:",
    "@publisle/blocks-technical": "catalog:",
    "@publisle/core": "catalog:",
    "@publisle/markdown": "catalog:",
    "@publisle/playground": "catalog:",
    "@publisle/profiles": "catalog:",
    "@publisle/schema": "catalog:",
    "@voidreg/authoring": "workspace:*",
    "dompurify": "^3.3.0",
    "mermaid": "12.2.0",
    "playwright-core": "1.65.0",
    "wavedrom": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2"
  }
}
