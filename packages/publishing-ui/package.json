{
  "name": "@voidreg/publishing-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Reader components, the interactive block kit and the sanitizer shared by the public site, the admin editor and the publishing compiler.",
  "exports": {
    "./api": "./src/api.ts",
    "./renderers": "./src/renderers.ts",
    "./publication-html": "./src/publication-html.ts",
    "./pagination": "./src/pagination.ts",
    "./ArticleBody.svelte": {
      "svelte": "./src/ArticleBody.svelte",
      "default": "./src/ArticleBody.svelte"
    },
    "./blocks/*": "./src/blocks/*.ts",
    "./ui/Select.svelte": {
      "svelte": "./src/ui/Select.svelte",
      "default": "./src/ui/Select.svelte"
    },
    "./ui/Combobox.svelte": {
      "svelte": "./src/ui/Combobox.svelte",
      "default": "./src/ui/Combobox.svelte"
    },
    "./ui/listbox": "./src/ui/listbox.ts",
    "./styles/base.css": "./src/styles/base.css",
    "./theme": "./src/theme.ts"
  },
  "dependencies": {
    "@publisle/adapter-core": "catalog:",
    "@publisle/adapter-svelte": "catalog:",
    "@publisle/block-sdk": "catalog:",
    "@publisle/blocks-core": "catalog:",
    "@publisle/schema": "catalog:",
    "isomorphic-dompurify": "^4.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "blocks:generate": "node scripts/generate-blocks.mjs",
    "blocks:check": "node scripts/generate-blocks.mjs --check",
    "new:block": "node scripts/new-block.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
